{
  "name": "@unity-ai-lab/admin-portal-server",
  "version": "0.0.1",
  "description": "Unified Node server: marketing site + admin portal frontend + backend APIs + WebSocket + visitor tracking. Per Docs/ADMIN_PORTAL_ARCHITECTURE.md.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "build": "tsc -p tsconfig.json && cp -r migrations dist/",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'TODO: add eslint per AP-067'"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0",
    "@hono/node-ws": "^1.0.0",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.36.0",
    "openid-client": "^6.1.0",
    "@simplewebauthn/server": "^11.0.0",
    "jose": "^5.9.0",
    "zod": "^3.23.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.5.0",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/better-sqlite3": "^7.6.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "drizzle-kit": "^0.27.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
