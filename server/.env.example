# Unity AI Lab Admin Portal — Server environment template
# Copy this file to server/.env (gitignored) and fill in the values.
# In dev, all defaults work out of the box — no real values needed.

# ============================================================================
# Core
# ============================================================================
NODE_ENV=development
PORT=2026
HOST=0.0.0.0

# Frontend / API base URL — used by frontend's config.js if served from a different origin
PUBLIC_BASE_URL=http://localhost:2026

# ============================================================================
# Database
# ============================================================================
# Dev: SQLite, auto-created on first boot
DATABASE_URL=sqlite://./server/data/dev.db

# Prod (uncomment + set): Postgres
# DATABASE_URL=postgres://admin_portal_app:CHANGEME@db.example.com:5432/admin_portal

# ============================================================================
# Auth — Dev bypass (LOCAL ONLY)
# ============================================================================
# DEV ONLY — when true, the login page shows a "Dev" tab that lets you log in as
# any of the 4 admins without a password. Server REJECTS this if NODE_ENV=production.
DEV_AUTH_BYPASS=false

# ============================================================================
# Auth — Universal claim window
# ============================================================================
# When true: any allowlisted admin email can claim an unclaimed account by hitting
# /api/auth/claim with email+password (no token). Founder turns this ON when
# distributing the universal `.claude/` template, OFF after all 4 are enrolled.
# Defaults to false; the bootstrap claim (no users in DB yet) works regardless.
ADMIN_CLAIM_OPEN=false

# ============================================================================
# Auth — Session JWT signing
# ============================================================================
# Dev: auto-generated and saved to local-keys/ on first boot if blank
# Prod: load from secrets manager — Ed25519 private key (PEM)
JWT_SIGNING_KEY=
JWT_ISSUER=admin.unityailab.com
JWT_AUDIENCE=admin.unityailab.com
JWT_TTL_SECONDS=43200

# ============================================================================
# Auth — CSRF
# ============================================================================
# Dev: auto-generated; Prod: load from secrets manager
CSRF_COOKIE_SECRET=

# ============================================================================
# Auth — WebAuthn
# ============================================================================
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Unity AI Lab Admin Portal
WEBAUTHN_ORIGIN=http://localhost:2026

# ============================================================================
# File storage
# ============================================================================
# Dev: local filesystem under server/data/uploads
FILE_STORAGE_KIND=local
FILE_STORAGE_LOCAL_PATH=./server/data/uploads

# Prod: R2 / S3 — set FILE_STORAGE_KIND=r2 and these:
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=admin-portal-files

# ============================================================================
# GitHub integration (Phase 3 — leave blank until then)
# ============================================================================
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_HMAC_SECRET=

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=debug
LOG_PRETTY=true

# ============================================================================
# Rate limiting
# ============================================================================
RATELIMIT_LOGIN_PER_15MIN=5
RATELIMIT_API_PER_MIN=600
RATELIMIT_WS_MSG_PER_SEC=10
