{
  "name": "unity-lab-ai-website",
  "version": "2.1.5",
  "description": "Unity AI Lab - Official website with AI demos, libraries, and tools",
  "main": "js/init.js",
  "scripts": {
    "dev": "npx --yes kill-port 2026 24678 && tsx watch server/src/index.ts",
    "dev:vite-only": "vite",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "build": "node generate-sitemap.js && vite build && node copy-assets.js && node cache-bust.js",
    "build:static": "node generate-sitemap.js && vite build && node copy-assets.js && node cache-bust.js",
    "build:server": "tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "sitemap": "node generate-sitemap.js",
    "cache-bust": "node cache-bust.js",
    "copy-assets": "node copy-assets.js",
    "minify": "npx terser js/init.js -c -m -o script.min.js && npx cleancss -o styles.min.css styles.css",
    "build:legacy": "npm run minify && ./update-version.sh",
    "migrate": "tsx server/src/db/migrate.ts",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Unity-Lab-AI/Unity-Lab-AI.github.io.git"
  },
  "keywords": [],
  "author": "Unity AI Lab - Hackall360, Sponge, GFourteen",
  "homepage": "https://www.unityailab.com",
  "license": "ISC",
  "dependencies": {
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0",
    "@hono/node-ws": "^1.0.0",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.36.0",
    "openid-client": "^6.1.0",
    "@simplewebauthn/server": "^11.0.0",
    "jose": "^5.9.0",
    "zod": "^3.23.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/better-sqlite3": "^7.6.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "drizzle-kit": "^0.27.0",
    "clean-css-cli": "^5.6.3",
    "lighthouse": "^13.0.1",
    "terser": "^5.44.1",
    "vite": "^7.2.4",
    "vite-plugin-static-copy": "^3.1.4"
  }
}
